# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
sbi-logs/
outputs/
data/
logs/
papers/
summary/
results/
slurm-logs/
# Claude Code: ignore local/transient state, but TRACK the shared agent system so
# that agents, commands, hooks and settings travel with every clone/pull/push.
# NOTE: must be `.claude/*` (not `.claude/`) — git will not descend into an
# ignored *directory*, so negations below would never be evaluated.
.claude/*
.claude/settings.local.json
.codex/
.claude/
arxiv/
all_arxiv/
tests/
# Knowledge-base derived cache (regenerated by tools/kb/kb.py; never committed).
# The source of truth is the tracked frontmatter in knowledge/**/*.md.
knowledge/.kb/
*.slurm
*.npy
*.pdf
*.pkl
*.pk
*.png
*.txt
*.fits
*.err
*.out
*.gz
*.fits
*.h5
*.hdf5

summary/
context/

