#!/usr/bin/env bash
# GODMAX_KB_HOOK — pre-push validation gate.
#
# Installed by:  python tools/kb/kb.py install-hooks
# Source of truth: tools/kb/githooks/pre-push  (tracked; .git/hooks is not)
#
# Blocks a push whose commits touch the scope of a knowledge document that is not
# verified at the current digest, or that has no journal entry, or that fails a
# blocker invariant. See knowledge/70-validation/GIT_SYNC.md.
#
# Recorded bypass:
#   GODMAX_KB_GATE=warn GODMAX_KB_GATE_REASON="cluster deadline, KB follows" git push

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
KB="$REPO_ROOT/tools/kb/kb.py"
PY="${GODMAX_KB_PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || PY=python

if [ ! -f "$KB" ]; then
  echo "[kb] tools/kb/kb.py missing — skipping gate." >&2
  exit 0
fi

ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue

  # Deleting a remote branch: nothing to validate.
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: validate against the closest existing remote branch
    # so we gate this branch's own work rather than the entire repository history.
    base=""
    for candidate in origin/main origin/HEAD origin/master; do
      if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
        base="$(git merge-base "$candidate" "$local_sha" 2>/dev/null)"
        [ -n "$base" ] && break
      fi
    done
    if [ -z "$base" ]; then
      base="$(git rev-list --max-parents=0 "$local_sha" | tail -1)"
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  echo ""
  echo "[kb] gating $local_ref  ($range)"
  "$PY" "$KB" gate --range "$range" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "[kb] push blocked. Fix the blockers, or use a recorded bypass:" >&2
  echo "     GODMAX_KB_GATE=warn GODMAX_KB_GATE_REASON=\"why\" git push" >&2
fi

exit "$status"
